# Optional local Docker environment file. All settings can also be exported.
# Run ruby bin/setup-local to create random keys, or use --stdout without a file.
AUTH_MODE=local
CCI_AREAS='{"zone_a":"Zone A","zone_b":"Zone B"}'
CCI_LEGACY_PATHS='{"zone_a":"/legacy"}'
# For separate local inventories, mount both paths in web and indexer:
# CCI_LEGACY_PATHS='{"zone_a":"/legacy/zone_a","zone_b":"/legacy/zone_b"}'
# No local inventory: CCI_LEGACY_PATHS='{}'
# Base64-encoded 32-byte keys; populate through secret management.
CCI_AREA_KEYS='{}'
# Existing per-area variables are also accepted if passed into the container:
# ZONE_A_KEY=
# ZONE_B_KEY=
# For Keycloak, set AUTH_MODE=oidc and configure:
OIDC_ISSUER=https://keycloak.example.test/realms/certui
OIDC_CLIENT_ID=cci-ui
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/keycloak/callback
