# Optional local Docker environment file. All settings can also be exported.
# Run ruby bin/setup-local to create random keys, or use --stdout without a file.
AUTH_MODE=local
# INFO for concise operations, DEBUG for external-system diagnostics.
LOG_LEVEL=INFO
# Show exception messages and stack traces on error pages (all visitors).
CCI_SHOW_ERROR_DETAILS=false
CCI_AREAS='{"zone_a":"Zone A","zone_b":"Zone B"}'
# single allows one target area; multiple allows the same certificate in several areas.
CCI_CERTIFICATE_AREA_MODE=multiple
# The web service needs a writable mount and directory permissions for confirmed deletion.
CCI_LEGACY_PATHS='{"zone_a":"/legacy"}'
# For separate local inventories, mount both paths in web and indexer:
# CCI_LEGACY_PATHS='{"zone_a":"/legacy/zone_a","zone_b":"/legacy/zone_b"}'
# No local inventory: CCI_LEGACY_PATHS='{}'
# Base64-encoded 32-byte keys; populate through secret management.
CCI_AREA_KEYS='{}'
# Existing per-area variables are also accepted if passed into the container:
# ZONE_A_KEY=
# ZONE_B_KEY=
# For Keycloak, set AUTH_MODE=oidc and configure:
OIDC_ISSUER=https://keycloak.example.test/realms/certui
OIDC_CLIENT_ID=cci-ui
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/keycloak/callback
# Claim shown in the UI. Allowed values: preferred_username, name, email.
OIDC_DISPLAY_NAME_CLAIM=preferred_username

# Optional PuppetDB host inventory; disabled by default. See docs/puppetdb.md.
PUPPETDB_ENABLED=false
PUPPETDB_URL=https://puppetdb.example.test:8081
PUPPETDB_FACT_NAME=certificates
PUPPETDB_FINGERPRINT_FIELD=fingerprint
PUPPETDB_FINGERPRINT_ALGORITHM=sha256
# Empty generates the inventory query from PUPPETDB_FACT_NAME.
PUPPETDB_QUERY=
# Mount these files read-only into the indexer when TLS credentials are needed.
PUPPETDB_CA_FILE=
PUPPETDB_CLIENT_CERT_FILE=
PUPPETDB_CLIENT_KEY_FILE=
PUPPETDB_TOKEN=
PUPPETDB_TIMEOUT=30
PUPPETDB_MAX_RESPONSE_BYTES=52428800

# Discover local CA chains after every index pass and show the CA inventory page.
CCI_CA_INVENTORY_ENABLED=false

# CSR form defaults. Blank subject fields are omitted from the request.
CSR_DEFAULT_KEY_ALGORITHM=RSA
CSR_DEFAULT_KEY_SIZE=4096
CSR_DEFAULT_DIGEST=SHA512
CSR_DEFAULT_COUNTRY=
CSR_DEFAULT_STATE=
CSR_DEFAULT_LOCALITY=
CSR_DEFAULT_ORGANIZATION=
CSR_DEFAULT_ORGANIZATIONAL_UNIT=

# Optional certificate diagnostics; see docs/certificate-diagnostics.md.
CCI_OCSP_ENABLED=false
CCI_OCSP_INTERVAL=21600
CCI_CRL_ENABLED=false
CCI_CRL_INTERVAL=21600
CCI_DIAGNOSTICS_BATCH_SIZE=20
CCI_DIAGNOSTICS_PASS_BUDGET=15
CCI_DIAGNOSTICS_REQUEST_TIMEOUT=5
CCI_DIAGNOSTICS_CONNECT_TIMEOUT=3
CCI_DIAGNOSTICS_MAX_BYTES=5242880
CCI_DIAGNOSTICS_REDIRECTS=3
CCI_DIAGNOSTICS_EVIDENCE_MAX_AGE=21600
CCI_DIAGNOSTICS_CLOCK_SKEW=300
CCI_DIAGNOSTICS_ALLOWED_NETWORKS=

# Public default TLS trust profiles; see docs/certificate-diagnostics.md.
CCI_TRUST_CHROME_ENABLED=false
CCI_TRUST_CHROME_INTERVAL=86400
CCI_TRUST_CHROME_TARGET=154.0.8037.57
CCI_TRUST_CHROME_UPDATE_INTERVAL=86400
CCI_TRUST_CHROME_MAX_AGE=604800
CCI_TRUST_FIREFOX_ENABLED=false
CCI_TRUST_FIREFOX_INTERVAL=86400
CCI_TRUST_FIREFOX_TARGET=156.0.1
CCI_TRUST_FIREFOX_UPDATE_INTERVAL=86400
CCI_TRUST_FIREFOX_MAX_AGE=604800
CCI_TRUST_EDGE_ENABLED=false
CCI_TRUST_EDGE_INTERVAL=86400
CCI_TRUST_EDGE_TARGET=windows-macos
CCI_TRUST_EDGE_UPDATE_INTERVAL=86400
CCI_TRUST_EDGE_MAX_AGE=604800
CCI_TRUST_APPLE_ENABLED=false
CCI_TRUST_APPLE_INTERVAL=86400
CCI_TRUST_APPLE_TARGET=macos-15-2024051500
CCI_TRUST_APPLE_UPDATE_INTERVAL=86400
CCI_TRUST_APPLE_MAX_AGE=604800
CCI_TRUST_UBUNTU_ENABLED=false
CCI_TRUST_UBUNTU_INTERVAL=86400
CCI_TRUST_UBUNTU_TARGET=noble-updates
CCI_TRUST_UBUNTU_UPDATE_INTERVAL=86400
CCI_TRUST_UBUNTU_MAX_AGE=604800
CCI_TRUST_REQUEST_TIMEOUT=10
CCI_TRUST_MAX_BYTES=20971520
CCI_TRUST_EXPANDED_MAX_BYTES=67108864
