# Local Docker development. Run ruby bin/setup-local to create random keys.
AUTH_MODE=local
# Generate independent secrets with ruby bin/setup-local. Never commit real keys.
ZONE_A_KEY=
ZONE_B_KEY=
# Optional alternative configuration (host path):
# CCI_AREAS_CONFIG=./config/areas.yml
# For Keycloak, set AUTH_MODE=oidc and configure:
OIDC_ISSUER=https://keycloak.example.test/realms/certui
OIDC_CLIENT_ID=cci-ui
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/keycloak/callback
