<% config = CertificateDiagnosticsConfiguration.new %>
<% if config.enabled.any? %>
  <% results = CertificateDiagnosticResult.where(area: certificate.area, fingerprint: certificate.fingerprint).index_by(&:check_id) %>
  <section class="panel detail-panel" aria-labelledby="diagnostics-heading">
    <h2 id="diagnostics-heading"><%= t("diagnostics.title") %></h2>
    <p class="muted"><%= t("diagnostics.scope") %></p>
    <% config.groups.each do |group, checks| %>
      <h3><%= t("diagnostics.groups.#{group}") %></h3>
      <% if group != "revocation" %>
        <p class="muted"><%= t(group == "policy" ? "diagnostics.scopes.chrome_policy" : "diagnostics.trust_scope") %></p>
      <% end %>
      <dl class="certificate-diagnostics">
        <% checks.each do |check| %>
          <%= render "diagnostic_result", config: config, check: check, results: results %>
        <% end %>
      </dl>
    <% end %>
  </section>
<% end %>
