<section class="panel detail-panel" id="puppetdb-hosts">
  <h2><%= t("ui.puppetdb_hosts") %></h2>
  <% if puppetdb_fingerprint_missing?(certificate) %>
    <p class="flash flash-error"><%= t("ui.puppetdb_fingerprint_missing") %></p>
  <% end %>
  <% if certificate.puppetdb_refresh_failed? %>
    <p class="flash flash-error"><%= t("ui.puppetdb_failed") %></p>
  <% end %>
  <% if certificate.puppetdb_checked_at %>
    <p><%= t("ui.host_count_html", count: certificate.puppetdb_hosts.size) %></p>
    <% if certificate.puppetdb_hosts.any? %>
      <ul><% certificate.puppetdb_hosts.each do |host| %><li class="mono break-word"><%= host %></li><% end %></ul>
    <% else %>
      <p><%= t("ui.puppetdb_no_hosts") %></p>
    <% end %>
    <p class="muted small"><%= t("ui.puppetdb_checked", time: l(certificate.puppetdb_checked_at, format: :long)) %></p>
  <% else %>
    <p><%= t("ui.puppetdb_no_query") %></p>
  <% end %>
</section>
