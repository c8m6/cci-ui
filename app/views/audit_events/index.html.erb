<% content_for :title, t("ui.audit_logs") %>
<div class="page-heading"><div><span class="eyebrow"><%= t("ui.audit_eyebrow") %></span><h1><%= t("ui.audit_logs") %></h1><p class="muted"><%= t("ui.audit_description") %></p></div></div>
<section class="panel catalog">
  <%= form_with url: audit_events_path, method: :get, class: "search-form" do |form| %>
    <div class="search-box"><%= icon("search") %><%= form.search_field :q, value: params[:q], placeholder: t("ui.audit_placeholder"), aria: { label: t("ui.search_audit") } %></div>
    <div class="filters">
      <label><%= t("ui.area") %><%= form.select :area, [[t("ui.all_authorized_areas"), ""], *current_identity.audit_areas.map { |area| [area_label(area), area] }], selected: params[:area] %></label>
      <label><%= t("ui.action") %><%= form.select :event_action, [[t("ui.all_actions"), ""], *AuditEvent::ACTIONS.map { |key| [AuditEvent.action_label(key), key] }], selected: params[:event_action] %></label>
      <label><%= t("ui.from") %><%= form.date_field :from, value: params[:from] %></label>
      <label><%= t("ui.through") %><%= form.date_field :to, value: params[:to] %></label>
      <%= form.submit t("ui.search"), class: "button secondary" %>
      <%= link_to t("ui.reset"), audit_events_path, class: "button quiet" %>
    </div>
  <% end %>
  <div class="results-heading"><h2><%= t("ui.event_count", count: @total) %></h2><span class="muted small"><%= t("ui.audit_timezone") %></span></div>
  <div class="table-scroll"><table class="audit-table"><thead><tr><th><%= t("ui.time_user") %></th><th><%= t("ui.area_action") %></th><th><%= t("ui.affected_certificates") %></th><th><%= t("ui.details") %></th></tr></thead><tbody>
    <% @events.each do |event| %>
      <tr>
        <td><time datetime="<%= event.occurred_at.iso8601 %>" class="nowrap"><%= l(event.occurred_at.in_time_zone, format: :long) %></time><div class="audit-actor"><%= event.actor %></div></td>
        <td><span class="area-pill"><%= area_label(event.area) %></span><div><%= AuditEvent.action_label(event.action) %></div></td>
        <td>
          <% Array(event.details["certificates"]).each do |cert| %>
            <div class="audit-certificate"><strong><%= cert["common_name"].presence || cert["subject"] %></strong>
              <% if cert["kind"] == "chain" %><span class="badge neutral"><%= t("ui.chain") %></span><% end %>
              <% if cert["lookup"].present? %><div><%= t("ui.lookup") %>: <code><%= cert["lookup"] %></code></div><% end %>
              <details><summary><%= t("ui.identification") %></summary><div><%= t("ui.subject") %>: <%= cert["subject"] %></div><div><%= t("ui.issuer") %>: <%= cert["issuer"] %></div><div><%= t("ui.serial") %>: <%= cert["serial"] %></div><div>SHA-256: <code><%= cert["fingerprint"] %></code></div><% if cert["source_id"] %><div><%= t("ui.source") %>: <%= cert["source"] %> · <code><%= cert["source_id"] %></code></div><% end %></details>
            </div>
          <% end %>
          <% if event.details["certificates"].blank? %><div class="muted small"><%= t("ui.audit_historical") %></div><% event.references.each do |reference| %><div class="mono"><%= reference %></div><% end %><% end %>
        </td>
        <td>
          <% if event.action == "archive" %><div><%= audit_comment(event) %></div><div><%= t("ui.scope") %>: <%= event.details["scope"] == "lookup" ? t("ui.scope_lookup") : t("ui.scope_fingerprint") %></div><% end %>
          <% if %w[status_change archive].include?(event.action) %><div><%= t("ui.puppet_status") %>: <code><%= event.details["previous_status"] %></code> → <code><%= event.details["status"] %></code></div><% end %>
          <% if event.details["format"] %><div><%= t("ui.format") %>: <%= event.details["format"].upcase %></div><div><%= t("ui.file") %>: <%= event.details["filename"] %></div><div><%= t("ui.private_keys") %>: <%= event.details["include_key"] ? t("ui.yes") : t("ui.no") %></div><div><%= t("ui.chain") %>: <%= event.details["include_chain"] ? t("ui.yes") : t("ui.no") %></div><% end %>
          <% if event.details["previous_version"] %><details><summary><%= t("ui.previous_active") %></summary><code><%= event.details["previous_version"] %></code></details><% end %>
          <% if event.details.key?("has_key") %><div><%= t("ui.key_available") %>: <%= event.details["has_key"] ? t("ui.yes") : t("ui.no") %></div><div><%= t("ui.tags") %>: <%= Array(event.details["tags"]).join(", ").presence || "–" %></div><% end %>
        </td>
      </tr>
    <% end %>
  </tbody></table></div>
  <% if @total.zero? %><div class="empty-state"><h2><%= t("ui.no_audit") %></h2><p><%= t("ui.no_audit_filters") %></p></div><% end %>
  <% filters = params.permit(:q, :area, :event_action, :from, :to).to_h %>
  <div class="pagination"><span class="muted small"><%= t("ui.page", page: @page, pages: @pages) %></span><div><% if @page > 1 %><%= link_to t("ui.back"), audit_events_path(filters.merge(page: @page - 1)), class: "button quiet" %><% end %><% if @page < @pages %><%= link_to t("ui.next"), audit_events_path(filters.merge(page: @page + 1)), class: "button quiet" %><% end %></div></div>
</section>
<p class="index-note"><%= t("ui.audit_delivery") %></p>
