<% content_for :title, "Anmelden" %>
<section class="login-card panel">
  <span class="eyebrow">WILLKOMMEN BEI CERTUI</span>
  <h1>Alles für Ihre Zertifikate.<br>An einem Ort.</h1>
  <p class="muted">Zertifikate finden, sicher verwalten und im passenden Format bereitstellen.</p>
  <% if ENV["AUTH_MODE"] == "local" %>
    <h2>Lokale Testanmeldung</h2><p class="muted">Wählen Sie eine Rolle, um deren Berechtigungen zu erproben.</p>
    <%= form_with url: local_login_path do |form| %>
      <%= form.label :identity, "Testidentität" %>
      <%= form.select :identity, SessionsController.local_identities.map { |id, (label, _roles)| [label, id] } %>
      <%= form.submit "Workspace öffnen →", class: "button primary full-width" %>
    <% end %>
  <% else %>
    <%= button_to "Mit Keycloak anmelden →", "/auth/keycloak", class: "button primary", data: { turbo: false } %>
  <% end %>
</section>
