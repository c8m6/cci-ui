<% content_for :title, t("ui.import") %>
<div class="page-heading"><div><span class="eyebrow"><%= t("ui.new_certificates") %></span><h1><%= t("ui.import_certificates") %></h1><p class="muted"><%= t("ui.import_description") %></p></div></div>
<% if @errors %><ul class="flash flash-error"><% @errors.each do |error| %><li><%= error %></li><% end %></ul><% end %>
<%= form_with url: imports_path, multipart: true, data: { turbo: false }, class: "import-layout" do |form| %>
<section class="panel detail-panel"><h2><%= t("ui.add_certificates") %></h2><label class="dropzone" data-controller="upload" data-action="dragover->upload#over dragleave->upload#leave drop->upload#drop"><%= icon("upload") %><strong><%= t("ui.choose_files") %></strong><span><%= t("ui.supported_files") %></span><%= form.file_field :files, multiple: true, data: { upload_target: "input", action: "change->upload#change" } %><span data-upload-target="label" aria-live="polite"></span></label>
<details><summary><%= t("ui.paste_pem") %></summary><%= form.text_area :pem, rows: 8, placeholder: "-----BEGIN CERTIFICATE-----", aria: { label: t("ui.pem_label") }, spellcheck: false %></details>
<%= form.label :password, t("ui.source_file_password") %><%= form.password_field :password, autocomplete: "off" %>
<p class="muted small"><%= t("ui.separate_keys") %></p>
</section><section class="panel detail-panel"><h2><%= t("ui.assignment") %></h2><fieldset class="area-choices"><legend><%= t("ui.target_areas") %></legend><% current_identity.areas.select { |area| current_identity.writer?(area) }.each_with_index do |area, index| %><label class="check-label"><%= check_box_tag "areas[]", area, index.zero?, id: "area_#{area}" %> <%= area_label(area) %></label><% end %></fieldset><p class="muted small"><%= t("ui.choose_areas") %></p>
<%= form.label :tags, t("ui.tags") %><%= form.text_field :tags, placeholder: t("ui.tags_placeholder"), maxlength: 500 %><p class="muted small"><%= t("ui.tags_help") %></p>
<%= form.label :certid, t("ui.optional_certid") %><%= form.text_field :certid, placeholder: t("ui.certid_placeholder"), maxlength: 120, pattern: "[a-zA-Z0-9_.-]+" %><p class="muted small"><%= t("ui.certid_help") %></p>
<div class="info-note"><%= t("ui.import_storage") %></div><%= form.submit t("ui.review_preview"), class: "button primary full-width" %></section>
<% end %>
