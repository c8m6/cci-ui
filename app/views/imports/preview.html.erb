<% content_for :title, t("ui.review_import") %>
<div class="page-heading"><div><span class="eyebrow"><%= t("ui.import_preview") %></span><h1><%= t("ui.ready_to_save") %></h1><p class="muted"><%= t("ui.preview_summary", count: @preview.fetch("entries").size, areas: @preview.fetch("areas").map { |area| area_label(area) }.to_sentence) %></p></div></div>
<section class="panel detail-panel">
  <% @preview.fetch("entries").each do |entry| %>
    <div class="preview-entry">
      <h2><%= entry.fetch("name") %> <span class="area-pill"><%= area_label(entry.fetch("area")) %></span></h2>
      <p class="mono small break-word"><%= entry.fetch("fingerprint") %></p>
      <p><span class="badge neutral"><%= entry["key"] ? t("ui.matching_key") : t("ui.public_certificate") %></span></p>
      <p class="muted small"><%= t("ui.certid_status", certid: entry.fetch("certid"), status: entry.fetch("rollout_status")) %></p>
      <% if entry.fetch("certid_index") > 0 %>
        <p class="flash flash-error"><%= t("ui.certid_exists") %></p>
        <p class="mono small break-word"><%= t("ui.previous_version", version: entry.fetch("previous_version")) %></p>
      <% end %>
    </div>
  <% end %>
  <%= form_with url: imports_path, data: { turbo: false } do |form| %>
    <%= form.hidden_field :token, value: @token %>
    <% if @preview.fetch("entries").any? { |entry| entry.fetch("certid_index") > 0 } %>
      <p><label class="check-label"><%= form.check_box :confirm_overwrite, { required: true }, "1", "0" %> <%= t("ui.overwrite_confirmation") %></label></p>
    <% end %>
    <%= form.submit t("ui.save_consul"), class: "button primary" %>
    <%= link_to t("ui.cancel"), new_import_path, class: "button quiet" %>
  <% end %>
</section>
