<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme" data-theme-light-value="<%= t('ui.theme_light') %>" data-theme-dark-value="<%= t('ui.theme_dark') %>">
<head>
  <title><%= content_for?(:title) ? yield(:title) + " · " : "" %>CCI-UI</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <% if @error_status %><meta name="turbo-visit-control" content="reload"><% end %>
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <a href="#main" class="skip-link"><%= t("ui.skip_content") %></a>
  <aside class="sidebar">
    <%= link_to root_path, class: "brand" do %><span class="brand-icon"><%= icon("shield") %></span>CCI<span class="brand-light">-UI</span><% end %>
    <div class="sidebar-caption">Controlled Cryptographic Item</div>
    <% if current_identity %>
      <nav aria-label="<%= t('ui.main_navigation') %>">
        <%= link_to certificates_path, class: "nav-item #{controller_name == 'certificates' ? 'active' : ''}" do %><%= icon("grid") %> <%= t("ui.certificates") %><% end %>
        <% if puppetdb_enabled? %><%= link_to hosts_path, class: "nav-item #{controller_name == 'hosts' ? 'active' : ''}" do %><%= icon("grid") %> <%= t("hosts.title") %><% end %><% end %>
        <% if current_identity.any_writer? %><%= link_to new_import_path, class: "nav-item #{controller_name == 'imports' ? 'active' : ''}" do %><%= icon("upload") %> <%= t("ui.import") %><% end %><% end %>
        <% if current_identity.any_csr? %><%= link_to certificate_requests_path, class: "nav-item #{controller_name == 'certificate_requests' ? 'active' : ''}" do %><%= icon("key") %> CSR<% end %><% end %>
        <% if current_identity.auditor? %><%= link_to audit_events_path, class: "nav-item #{controller_name == 'audit_events' ? 'active' : ''}" do %><%= icon("shield") %> <%= t("ui.audit_logs") %><% end %><% end %>
      </nav>
      <details class="sidebar-roles">
        <summary><%= t("ui.my_cci_roles") %></summary>
        <% AreaConfiguration.ids.sort_by { |area| [area_label(area).downcase, area] }.each do |area| %>
          <% roles = current_identity.roles.select { |role| AreaConfiguration::ROLE_TYPES.any? { |type| role == "#{area}_#{type}" } }.uniq.sort %>
          <% next if roles.empty? %>
          <div class="area-roles"><strong><%= area_label(area) %></strong><ul><% roles.each do |role| %><li><%= role %></li><% end %></ul></div>
        <% end %>
      </details>
    <% end %>
    <div class="sidebar-bottom"><span class="system-dot"></span> <%= t("ui.sidebar_title") %><br><small><%= t("ui.sidebar_subtitle") %></small><div class="sidebar-version"><span><%= ApplicationBuild.version %></span><%= link_to "https://github.com/c8m6/cci-ui", class: "sidebar-github", target: "_blank", rel: "noopener noreferrer" do %><%= icon("github") %> GitHub<% end %></div></div>
  </aside>
  <div class="workspace">
    <header class="topbar"><span><%= t("ui.workspace") %> <span class="crumb">/</span> <%= { "dashboard" => t("dashboard.title"), "hosts" => t("hosts.title"), "certificate_requests" => t("csr.title"), "imports" => t("ui.import"), "audit_events" => t("ui.audit_logs") }.fetch(controller_name, t("ui.certificates")) %></span><div class="account"><button type="button" class="theme-toggle" data-action="theme#toggle" data-theme-target="button" aria-label="<%= t('ui.theme_dark') %>">◐</button>
      <% if CciConfiguration.current.dig("authentication", "mode") == "local" %><span class="badge neutral"><%= t("ui.local_mode") %></span><% end %>
      <% if current_identity %><span class="account-name"><%= current_identity.display_name %></span><%= button_to t("ui.logout"), logout_path, method: :delete, class: "text-button" %><% end %>
      <details class="language-menu">
        <summary aria-label="<%= t('ui.language') %>" title="<%= t('ui.language') %>"><%= I18n.locale.to_s.upcase %><span aria-hidden="true">⌄</span></summary>
        <div class="language-options">
          <%= form_with url: locale_path, data: { turbo: false, controller: "locale", action: "submit->locale#prepare", locale_follow_location_value: request.get? && !@error_status } do |form| %>
            <%= form.hidden_field :return_to, value: locale_return_path, data: { locale_target: "destination" } %>
            <% I18n.available_locales.each do |locale| %>
              <button type="submit" name="locale" value="<%= locale %>" lang="<%= locale %>" aria-pressed="<%= cookies.signed[:locale] == locale.to_s %>"><%= t('language_name', locale: locale) %></button>
            <% end %>
            <button type="submit" name="locale" value="" class="browser-language" aria-pressed="<%= cookies.signed[:locale].blank? %>"><%= t('ui.browser_language') %></button>
          <% end %>
        </div>
      </details>
    </div></header>
    <main id="main" class="<%= content_for(:main_class) %>" tabindex="-1">
      <% flash.each do |type, message| %><div role="status" class="flash <%= type == 'alert' ? 'flash-error' : '' %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <footer>CCI-UI · Controlled Cryptographic Item</footer>
  </div>
</body>
</html>
