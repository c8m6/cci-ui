<!DOCTYPE html>
<html lang="de" data-controller="theme">
<head>
  <title><%= content_for?(:title) ? yield(:title) + " · " : "" %>CCI-UI</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <a href="#main" class="skip-link">Zum Inhalt</a>
  <aside class="sidebar">
    <%= link_to root_path, class: "brand" do %><span class="brand-icon"><%= icon("shield") %></span>CCI<span class="brand-light">-UI</span><% end %>
    <div class="sidebar-caption">CONTROLLED CLASSIFIED ITEM</div>
    <% if current_identity %>
      <nav aria-label="Hauptnavigation">
        <% if current_identity.auditor? %><%= link_to audit_events_path, class: "nav-item #{controller_name == 'audit_events' ? 'active' : ''}" do %><%= icon("shield") %> Auditlogs<% end %><% end %>
        <%= link_to root_path, class: "nav-item #{controller_name == 'certificates' ? 'active' : ''}" do %><%= icon("grid") %> Übersicht<% end %>
        <% if current_identity.any_writer? %><%= link_to new_import_path, class: "nav-item #{controller_name == 'imports' ? 'active' : ''}" do %><%= icon("upload") %> Zertifikate importieren<% end %><% end %>
      </nav>
      <div class="sidebar-caption section-caption">MEINE BEREICHE</div>
      <% current_identity.areas.each do |area| %>
        <%= link_to certificates_path(area: area), class: "area-link" do %><span class="area-dot"></span><%= area_label(area) %><span class="role-label"><%= current_identity.writer?(area) ? "Writer" : "Reader" %></span><% end %>
      <% end %>
    <% end %>
    <div class="sidebar-bottom"><span class="system-dot"></span> Zertifikate im Blick.<br><small>Zentral verwaltet. Klar zugeordnet.</small></div>
  </aside>
  <div class="workspace">
    <header class="topbar"><span>Workspace <span class="crumb">/</span> <%= { "imports" => "Import", "audit_events" => "Auditlogs" }.fetch(controller_name, "Zertifikate") %></span><div class="account"><button type="button" class="theme-toggle" data-action="theme#toggle" data-theme-target="button" aria-label="Dunkles Farbschema verwenden">◐</button>
      <% if ENV["AUTH_MODE"] == "local" %><span class="badge neutral">Lokaler Testmodus</span><% end %>
      <% if current_identity %><span class="account-name"><%= current_identity.name %></span><%= button_to "Abmelden", logout_path, method: :delete, class: "text-button" %><% end %>
    </div></header>
    <main id="main" tabindex="-1">
      <% flash.each do |type, message| %><div role="status" class="flash <%= type == 'alert' ? 'flash-error' : '' %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <footer>CCI-UI · Controlled classified item</footer>
  </div>
</body>
</html>
