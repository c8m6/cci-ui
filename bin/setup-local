#!/usr/bin/env ruby
# frozen_string_literal: true

require "securerandom"
require "base64"
require "yaml"

abort "Usage: ruby bin/setup-local [--stdout]" unless ARGV.empty? || ARGV == ["--stdout"]
path = File.expand_path("../config.yml", __dir__)
if ARGV.empty? && File.exist?(path)
  puts "config.yml already exists and will be preserved."
  exit
end
settings = {
  "version" => 1,
  "authentication" => { "mode" => "local" },
  "server" => { "secret_key_base" => SecureRandom.hex(64) },
  "database" => { "host" => "db", "name" => "certui_development", "username" => "certui", "password" => "certui" },
  "consul" => { "url" => "http://consul:8500" },
  "areas" => { "zone_a" => { "name" => "Zone A", "filesystem" => { "legacy_path" => "/legacy" } },
               "zone_b" => { "name" => "Zone B" } }
}
settings["areas"].each_value { |area| area["encryption_key"] = Base64.strict_encode64(SecureRandom.random_bytes(32)) }
if ARGV == ["--stdout"]
  puts YAML.dump(settings)
else
  File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) { |file| file.write(YAML.dump(settings)) }
  puts "Created local config.yml. Preserve its keys; existing ENV configuration must be migrated manually."
end
