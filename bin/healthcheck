#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require_relative "../lib/cci_configuration"

begin
  http = Net::HTTP.new("127.0.0.1", CciConfiguration.current.dig("server", "port"), nil)
  http.open_timeout = 2
  http.read_timeout = 5
  http.max_retries = 0
  host = CciConfiguration.current.dig("server", "host")
  response = http.get("/ready", "Host" => host)
  exit(response.code == "200" ? 0 : 1)
rescue StandardError
  exit 1
end
